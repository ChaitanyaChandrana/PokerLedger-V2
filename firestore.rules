rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // V1 is not used in the separate V2 Firebase project.
    match /poker_games/{gameCode} {
      allow read, write: if false;
    }

    match /poker_games_v2/{gameCode} {
      function hasMembersMap() {
        return resource.data.members is map;
      }
      function incomingHasMembersMap() {
        return request.resource.data.members is map;
      }
      function isMember() {
        return signedIn()
          && hasMembersMap()
          && resource.data.members.keys().hasAny([request.auth.uid]);
      }
      function memberPlayerId() {
        return resource.data.members[request.auth.uid];
      }
      function isHost() {
        return signedIn() && resource.data.hostUid == request.auth.uid;
      }
      function isCoHost() {
        return signedIn() && resource.data.coHostUid == request.auth.uid;
      }
      function currentClientWrite() {
        return request.resource.data.lastClientVersion == '2.6'
          && request.resource.data.writeNonce is string
          && request.resource.data.writeNonce != resource.data.writeNonce;
      }
      function immutableCoreUnchanged() {
        return request.resource.data.code == resource.data.code
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.appVersion == resource.data.appVersion
          && request.resource.data.protocolVersion == resource.data.protocolVersion
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.hostId == resource.data.hostId;
      }
      function validAutomaticInitial(player, cents) {
        return player.buyins is list
          && player.buyins.size() == 1
          && player.buyins[0].amountCents == cents
          && player.buyins[0].kind == 'initial'
          && player.buyins[0].approved == true
          && player.buyins[0].approvalMethod == 'join';
      }

      // The host is the authority for the table, but cannot alter their own
      // approved buy-ins. Host buy-ins are verified/corrected by the co-host.
      function hostUpdate() {
        return isHost()
          && currentClientWrite()
          && immutableCoreUnchanged()
          && (request.resource.data.coHostId == null ? request.resource.data.coHostUid == null :
              (request.resource.data.coHostId != resource.data.hostId
                && activeMember(request.resource.data,request.resource.data.coHostUid)
                && request.resource.data.members[request.resource.data.coHostUid] == request.resource.data.coHostId))
          && request.resource.data.get("hostEpoch",0) == resource.data.get("hostEpoch",0)
          && request.resource.data.get("lastHostTransfer",null) == resource.data.get("lastHostTransfer",null)
          && request.resource.data.players[resource.data.hostId].buyins
              == resource.data.players[resource.data.hostId].buyins
          && request.resource.data.players[resource.data.hostId].cashedOut
                == resource.data.players[resource.data.hostId].cashedOut
          && request.resource.data.players[resource.data.hostId].finalCents
                == resource.data.players[resource.data.hostId].finalCents
          && request.resource.data.players[resource.data.hostId].finalAmount
                == resource.data.players[resource.data.hostId].finalAmount;
      }

      function activeMember(g, u) {
        return u is string && g.members.keys().hasAny([u])
          && g.players[g.members[u]].authUid == u
          && g.players[g.members[u]].get('removed',false) == false;
      }
      function mayApprove(g, r) {
        return activeMember(g, request.auth.uid)
          && g.members[request.auth.uid] != r.targetId
          && g.players[r.targetId].get('removed',false) == false
          && (r.targetId == g.hostId || g.hostUid == request.auth.uid);
      }
      function verifiedLedgerUpdate() {
        let id = request.resource.data.lastVerifiedRequestId;
        let before = get(/databases/$(database)/documents/poker_games_v2/$(gameCode)/requests/$(id)).data;
        let after = getAfter(/databases/$(database)/documents/poker_games_v2/$(gameCode)/requests/$(id)).data;
        return signedIn() && mayApprove(resource.data,before) && currentClientWrite()
          && before.status == 'pending' && after.status == 'approved'
          && after.decidedByUid == request.auth.uid
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players','revision','updatedAtMs','lastVerifiedRequestId','lastClientVersion','writeNonce'])
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([before.targetId]);
      }
      function hostTransferUpdate() {
        let c = getAfter(/databases/$(database)/documents/poker_games_v2/$(gameCode)/host_control/current).data;
        let g = resource.data;
        let n = request.resource.data;
        return signedIn() && activeMember(g,request.auth.uid) && currentClientWrite()
          && g.phase in ['active','settling']
          && c.status == 'approved' && c.fromHostId == g.hostId && c.fromHostUid == g.hostUid
          && c.hostEpoch == g.get('hostEpoch',0)
          && activeMember(g,c.candidateUid) && g.members[c.candidateUid] == c.candidateId
          && n.hostId == c.candidateId && n.hostUid == c.candidateUid
          && n.coHostId == null && n.coHostUid == null
          && n.hostEpoch == g.get('hostEpoch',0)+1 && n.lastHostTransfer == c.nonce
          && n.revision == g.revision+1
          && n.diff(g).affectedKeys().hasOnly(['hostId','hostUid','coHostId','coHostUid','hostEpoch',
            'lastHostTransfer','revision','updatedAtMs','lastClientVersion','writeNonce']);
      }

      // Co-host may correct/void the host's buy-in history. The app only
      // exposes a reasoned VOID action; players cannot alter their own ledger.
      function coHostHostCorrectionUpdate() {
        return isCoHost()
          && currentClientWrite()
          && resource.data.phase == 'active'
          && request.resource.data.phase == 'active'
          && immutableCoreUnchanged()
          && request.resource.data.lastVerifiedRequestId == resource.data.lastVerifiedRequestId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players', 'revision', 'updatedAtMs', 'lastClientVersion', 'writeNonce'
          ])
          && request.resource.data.players.diff(resource.data.players).affectedKeys()
              .hasOnly([resource.data.hostId])
          && request.resource.data.players[resource.data.hostId]
              .diff(resource.data.players[resource.data.hostId]).affectedKeys()
              .hasOnly(['buyins']);
      }

      function coHostHostCashoutCorrectionUpdate() {
        return isCoHost()
          && currentClientWrite()
          && (resource.data.phase == 'active' || resource.data.phase == 'settling')
          && request.resource.data.phase == resource.data.phase
          && immutableCoreUnchanged()
          && request.resource.data.lastVerifiedRequestId == resource.data.lastVerifiedRequestId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players', 'revision', 'updatedAtMs', 'lastClientVersion', 'writeNonce'
          ])
          && request.resource.data.players.diff(resource.data.players).affectedKeys()
              .hasOnly([resource.data.hostId])
          && request.resource.data.players[resource.data.hostId]
              .diff(resource.data.players[resource.data.hostId]).affectedKeys()
              .hasOnly(['cashedOut', 'finalCents', 'finalAmount']);
      }

      function memberSelfUpdate() {
        return isMember()
          && currentClientWrite()
          && immutableCoreUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players', 'revision', 'updatedAtMs', 'lastClientVersion', 'writeNonce'
          ])
          && request.resource.data.players.diff(resource.data.players).affectedKeys()
              .hasOnly([memberPlayerId()])
          && request.resource.data.players[memberPlayerId()].authUid == request.auth.uid
          && request.resource.data.players[memberPlayerId()]
              .diff(resource.data.players[memberPlayerId()]).affectedKeys()
              .hasOnly(['name', 'phone']);
      }

      // Everyone joins the same way: joining automatically creates the
      // standard initial buy-in. Rebuys use authenticated requests below.
      function firstJoinUpdate() {
        let pid = request.resource.data.members[request.auth.uid];
        return signedIn()
          && currentClientWrite()
          && !isMember()
          && incomingHasMembersMap()
          && request.resource.data.members.keys().hasAny([request.auth.uid])
          && resource.data.phase == 'active'
          && resource.data.joinLocked == false
          && request.resource.data.phase == 'active'
          && immutableCoreUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'players', 'members', 'revision', 'updatedAtMs', 'lastClientVersion', 'writeNonce'
          ])
          && request.resource.data.members.diff(resource.data.members).affectedKeys()
              .hasOnly([request.auth.uid])
          && !resource.data.players.keys().hasAny([pid])
          && request.resource.data.players.diff(resource.data.players).affectedKeys()
              .hasOnly([pid])
          && request.resource.data.players[pid].id == pid
          && request.resource.data.players[pid].authUid == request.auth.uid
          && validAutomaticInitial(request.resource.data.players[pid], resource.data.buyInCents)
          && request.resource.data.players[pid].cashedOut == false
          && request.resource.data.players[pid].finalAmount == null
          && request.resource.data.players[pid].finalCents == null;
      }

      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.schemaVersion == 2
        && request.resource.data.appVersion == '2.6'
        && request.resource.data.protocolVersion == 26
        && request.resource.data.lastClientVersion == '2.6'
        && request.resource.data.writeNonce is string
        && request.resource.data.code == gameCode
        && request.resource.data.joinLocked == false
        && request.resource.data.phase == 'active'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasAny([request.auth.uid])
        && request.resource.data.hostId == request.resource.data.members[request.auth.uid]
        && request.resource.data.players[request.resource.data.hostId].authUid == request.auth.uid
        && validAutomaticInitial(
             request.resource.data.players[request.resource.data.hostId],
             request.resource.data.buyInCents
           );

      allow update: if hostUpdate()
        || verifiedLedgerUpdate()
        || coHostHostCorrectionUpdate()
        || coHostHostCashoutCorrectionUpdate()
        || hostTransferUpdate()
        || memberSelfUpdate()
        || firstJoinUpdate();
      allow delete: if false;

      match /host_control/{controlId} {
        function g() {return get(/databases/$(database)/documents/poker_games_v2/$(gameCode)).data;}
        function current(c) {
          let p=g();
          return c.status == 'pending' && c.fromHostId == p.hostId && c.fromHostUid == p.hostUid
            && c.hostEpoch == p.get('hostEpoch',0) && request.time < c.createdAt + duration.value(600,'s');
        }
        function transferred(c) {
          let n=getAfter(/databases/$(database)/documents/poker_games_v2/$(gameCode)).data;
          return n.hostId == c.candidateId && n.hostUid == c.candidateUid
            && n.hostEpoch == c.hostEpoch+1 && n.lastHostTransfer == c.nonce;
        }
        function proposal() {
          let p=g();let c=request.resource.data;
          return c.keys().hasOnly(['mode','status','candidateId','candidateUid','fromHostId','fromHostUid',
              'hostEpoch','createdByUid','createdAt','nonce','vote1Uid','vote2Uid'])
            && c.fromHostId == p.hostId && c.fromHostUid == p.hostUid && c.hostEpoch == p.get('hostEpoch',0)
            && activeMember(p,c.candidateUid) && p.members[c.candidateUid] == c.candidateId && c.candidateId != p.hostId
            && c.createdByUid == request.auth.uid && c.createdAt == request.time
            && c.nonce is string && c.nonce.size()>0 && c.vote1Uid == null && c.vote2Uid == null
            && ((c.mode=='transfer' && p.hostUid==request.auth.uid && c.status=='pending')
              || (c.mode=='recovery' && p.coHostId==null && c.candidateUid==request.auth.uid && c.status=='pending')
              || (c.mode=='cohost' && p.coHostUid==request.auth.uid && c.candidateUid==request.auth.uid
                && c.status=='approved' && transferred(c)));
        }
        function decision() {
          let p=g();let b=resource.data;let n=request.resource.data;
          return current(b) && (
            (n.diff(b).affectedKeys().hasOnly(['status']) && n.status=='cancelled'
              && request.auth.uid in [p.hostUid,b.createdByUid,b.candidateUid])
            || (b.mode=='transfer' && request.auth.uid==b.candidateUid && n.status=='approved'
              && n.diff(b).affectedKeys().hasOnly(['status']) && transferred(n))
            || (b.mode=='recovery' && p.coHostId==null && request.auth.uid!=p.hostUid && request.auth.uid!=b.candidateUid
              && ((b.vote1Uid==null && n.vote1Uid==request.auth.uid && n.status=='pending'
                   && n.diff(b).affectedKeys().hasOnly(['vote1Uid']))
                || (activeMember(p,b.vote1Uid) && b.vote1Uid!=p.hostUid && b.vote1Uid!=b.candidateUid
                   && request.auth.uid!=b.vote1Uid && n.vote2Uid==request.auth.uid && n.status=='approved'
                   && n.diff(b).affectedKeys().hasOnly(['vote2Uid','status']) && transferred(n)))));
        }
        allow read: if signedIn() && activeMember(g(),request.auth.uid);
        allow create: if controlId=='current' && signedIn() && activeMember(g(),request.auth.uid)
          && g().phase in ['active','settling'] && proposal();
        allow update: if controlId=='current' && signedIn() && activeMember(g(),request.auth.uid)
          && g().phase in ['active','settling'] && ((!current(resource.data) && proposal()) || decision());
        allow delete: if false;
      }
      match /requests/{requestId} {
        function parentNow() {return get(/databases/$(database)/documents/poker_games_v2/$(gameCode)).data;}
        function parentAfter() {return getAfter(/databases/$(database)/documents/poker_games_v2/$(gameCode)).data;}
        function member() {return signedIn() && activeMember(parentNow(),request.auth.uid);}
        function validCreate() {
          let g=parentNow();let r=request.resource.data;let mine=g.members[request.auth.uid];
          return r.keys().hasOnly(['schemaVersion','clientVersion','type','status','targetId','targetUid',
              'amountCents','amount','approverId','approverUid','requesterId','requesterUid','ts',
              'approvalMode','challengeId','challengeExpiresAtMs'])
            && requestId=='pending_'+mine && r.schemaVersion==2 && r.clientVersion=='2.6' && r.status=='pending'
            && r.targetId==mine && r.targetUid==request.auth.uid && r.requesterId==mine && r.requesterUid==request.auth.uid
            && r.amountCents is int && r.amountCents<=9007199254740991 && r.amount==r.amountCents / 100.0
            && ((r.type=='buyin' && g.phase=='active' && !g.players[mine].cashedOut && r.amountCents>0)
              || (r.type=='cashout' && g.phase in ['active','settling'] && r.amountCents>=0))
            && r.approverId==(mine==g.hostId?null:g.hostId) && r.approverUid==(mine==g.hostId?null:g.hostUid)
            && r.approvalMode=='tap' && r.challengeId is string && r.challengeId.size()>0 && r.challengeExpiresAtMs==0;
        }
        function decisionFields() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decidedAt','decidedByUid','decidedByPlayerId'])
            && request.resource.data.decidedByUid==request.auth.uid
            && request.resource.data.decidedByPlayerId==parentNow().members[request.auth.uid];
        }
        function resolve() {
          let g=parentNow();let r=resource.data;let n=request.resource.data;
          return r.status=='pending' && decisionFields()
            && ((n.status=='rejected' && mayApprove(g,r))
              || (n.status=='cancelled' && request.auth.uid in [r.requesterUid,g.hostUid]));
        }
        function appendValid(g,n,r) {
          let b=g.players[r.targetId].buyins;let a=n.players[r.targetId].buyins;let added=a[b.size()];
          return a.size()==b.size()+1 && a==b.concat([added])
            && added.keys().hasOnly(['id','ts','amountCents','amount','kind','approved','approvedBy','requestId','approvalMethod','challengeId'])
            && added.id is string && added.ts is int && added.requestId==requestId
            && added.amountCents==r.amountCents && added.amount==r.amountCents / 100.0
            && added.kind=='rebuy' && added.approved==true && added.approvedBy==g.members[request.auth.uid]
            && added.approvalMethod=='tap' && added.challengeId==r.get('challengeId','legacy');
        }
        function approve() {
          let g=parentNow();let n=parentAfter();let r=resource.data;let target=r.targetId;
          return r.status=='pending' && request.resource.data.status=='approved' && decisionFields() && mayApprove(g,r)
            && n.phase==g.phase && n.revision==g.revision+1 && n.lastVerifiedRequestId==requestId
            && n.diff(g).affectedKeys().hasOnly(['players','revision','updatedAtMs','lastVerifiedRequestId','lastClientVersion','writeNonce'])
            && n.players.diff(g.players).affectedKeys().hasOnly([target])
            && ((r.type=='buyin' && g.phase=='active' && !g.players[target].cashedOut
                && n.players[target].diff(g.players[target]).affectedKeys().hasOnly(['buyins']) && appendValid(g,n,r))
              || (r.type=='cashout' && g.phase in ['active','settling']
                && n.players[target].diff(g.players[target]).affectedKeys().hasOnly(['cashedOut','finalCents','finalAmount'])
                && n.players[target].cashedOut==true && n.players[target].finalCents==r.amountCents && n.players[target].finalAmount==r.amount));
        }
        allow read: if member();
        allow create: if member() && validCreate();
        allow update: if member() && ((resource.data.status!='pending' && validCreate()
            && request.resource.data.challengeId!=resource.data.challengeId) || resolve() || approve());
        allow delete: if false;
      }

      // QR is now an optional request shortcut, not a separate approval credential.
      match /buyin_challenges/{challengeId} { allow read, write: if false; }

      match /events/{eventId} {
        function parentAfterForEvent() {
          return getAfter(/databases/$(database)/documents/poker_games_v2/$(gameCode));
        }
        function actorIsMemberAfter() {
          return signedIn()
            && parentAfterForEvent().data.members is map
            && parentAfterForEvent().data.members.keys().hasAny([request.auth.uid]);
        }
        function actorIsMemberNow() {
          let g = get(/databases/$(database)/documents/poker_games_v2/$(gameCode));
          return signedIn()
            && g.data.members is map
            && g.data.members.keys().hasAny([request.auth.uid]);
        }

        allow get, list: if actorIsMemberNow();
        allow create: if actorIsMemberAfter()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.schemaVersion == 2;
        allow update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
